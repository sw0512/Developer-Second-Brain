{
  "description": "Developer Second Brain — after real editing work, silently ask the model to judge whether it is worth recording (proposes only; never saves), and refuse a new vault document the user was never shown",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/detect-on-edit.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-vault-write.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
